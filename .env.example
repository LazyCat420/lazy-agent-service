# ─── Core ────────────────────────────────────────────────────
# PORT is the HOST-side port docker-compose publishes (host PORT → container
# 7778). External callers must use http://<host>:5591.
#
# Three names, do not conflate them:
#   PORT                   host-side publish port for compose (5591)
#   LAZY_TOOL_BIND_PORT    what this process listens on inside the container (7778)
#   LAZY_TOOL_SERVICE_PORT the external port advertised to prism and siblings (5591)
PORT=5591
LAZY_TOOL_SERVICE_API_KEY=<YOUR_API_KEY>
NODE_ENV=production

# ─── Required in practice (hydrated from vault-service at boot when
#     available; set explicitly when running without vault) ─────────
# MONGO_URI=mongodb://<YOUR_NAS_IP>:27017        # hard dependency at startup
# TRADING_MONGO_DB=trading_bot                   # the /platform dashboard's
#   source: tool_usage_stats lives in the TRADING database, a different
#   database on the same server. Registered at boot beside the prism one;
#   unset or unreachable, the four /platform endpoints answer 503.
# TOOLS_SERVICE_URL=http://<YOUR_NAS_IP>:5590    # GitWorktreeHelper breaks if unset
# REAL_PRISM_URL=http://<YOUR_NAS_IP>:7777       # prism-proxy upstream target

# ─── CORS (optional — comma-separated additional origins) ───
# CORS_ORIGINS=http://192.168.1.100:3000,http://custom-domain:8888

# ─── Python Execution ──────────────────────────────────────
# PYTHON_INTERPRETER=/opt/venv/bin/python
# PYTHON_EXEC_SCRIPT=/app/python/scripts/execute_tool.py
# PYTHON_CWD=/app/python
# PYTHONPATH=/app/python
# EXECUTION_TIMEOUT_MS=30000

# ─── Trading Service ──────────────────────────────────────
TRADING_SERVICE_URL=http://<YOUR_NAS_IP>:3031
TRADING_SERVICE_API_KEY=<YOUR_TRADING_SERVICE_API_KEY>

# ─── MongoDB (optional) ──────────────────────────────────
# MONGO_URI=mongodb://<MONGO_USER>:<MONGO_PASS>@<YOUR_NAS_IP>:27017/?directConnection=true&authSource=admin

# ─── Cache ───────────────────────────────────────────────
# CACHE_TTL_MS=60000

# ─── HTML Notes ──────────────────────────────────────────────
HTML_NOTES_URL=http://<YOUR_NAS_IP>:8035

# ─── Treesearch (cannabis strain research) ───────────────────
# Backs the strain_* agent tools: strain names, forum posts, photos, terpenes.
# Set this in .env, NOT in docker-compose `environment:` — a compose `environment:`
# entry overrides env_file and silently shadows whatever is here.
TREESEARCH_SERVICE_URL=http://<YOUR_NAS_IP>:8005

# ─── Service URL ─────────────────────────────────────────────
# NOTE: LAZY_TOOL_SERVICE_URL is no longer read from the environment. It is a
# self-referential loopback URL derived from LAZY_TOOL_BIND_PORT in config.ts —
# setting it here to the external :5591 pointed the process at a port nothing
# listens on inside the container. Override LAZY_TOOL_BIND_PORT instead.
# LAZY_TOOL_SERVICE_PORT=5591
