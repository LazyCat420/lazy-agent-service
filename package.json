{
  "name": "lazy-agent-service",
  "version": "0.1.0",
  "description": "Unified lazy-agent-service that consolidates Python tools and exposes them via REST and MCP SSE",
  "type": "module",
  "main": "dist/boot.js",
  "scripts": {
    "start": "node --import ./dist/src/telemetry/otel.js dist/boot.js",
    "dev": "tsx watch boot.ts",
    "build": "npm run build:runtime && npm run build:agent-chat && npm run build:chat-ui",
    "export:contracts": "node scripts/export-contracts.mjs",
    "export:runtime-wire": "tsx scripts/export-runtime-wire.ts",
    "typecheck": "tsc --noEmit",
    "smoke:otel": "node scripts/otel-smoke.mjs",
    "test": "vitest run --exclude \"**/.worktrees/**\"",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "deploy": "bash deploy.sh",
    "deploy:dry": "bash deploy.sh --dry-run",
    "build:runtime": "tsc && mkdir -p dist/src && cp -r src/locales dist/src/locales && node scripts/export-contracts.mjs",
    "build:agent-chat": "npm run export:runtime-wire && node scripts/export-chat-contract.mjs && npm run build --workspace=@lazycat/agent-chat",
    "test:agent-chat": "vitest run packages/agent-chat/test",
    "pack:agent-chat": "npm run build:agent-chat && npm pack --workspace=@lazycat/agent-chat --pack-destination=vendor",
    "build:chat-ui": "esbuild public/chat/src/app.ts --bundle --outfile=public/chat/app.js --format=esm --target=es2020 --minify --log-level=warning",
    "coverage": "vitest run --coverage --coverage.reporter=json --coverage.reporter=text-summary --coverage.include=\"src/**/*.ts\" --coverage.exclude=\"**/__tests__/**\" --coverage.exclude=\"**/*.test.ts\"",
    "quality:crap": "npm run coverage && node scripts/quality/crap.mjs",
    "quality:dry": "node scripts/quality/dry.mjs",
    "quality:arch": "node scripts/quality/arch.mjs",
    "quality:deadcode": "node scripts/quality/deadcode.mjs",
    "quality": "npm run quality:crap && npm run quality:dry && npm run quality:arch && npm run quality:deadcode && npm run quality:prompt",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run quality:dry && npm run quality:arch && npm run quality:prompt",
    "quality:prompt": "node scripts/quality/prompt-budget.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.103.0",
    "@google/genai": "^2.4.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-express": "^0.71.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-mongodb": "^0.76.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@rodrigo-barraza/utilities-library": "file:vendor/rodrigo-barraza-utilities-library-0.4.0.tgz",
    "cors": "^2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "^8.5.2",
    "minio": "^8.0.7",
    "mongodb": "^7.2.0",
    "openai": "^6.37.0",
    "sharp": "^0.35.5",
    "undici": "^8.12.3",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "25.9.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "4.1.12",
    "dependency-cruiser": "^18.7.0",
    "esbuild": "^0.25.12",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.6.0",
    "jscpd": "^5.4.2",
    "knip": "^6.43.0",
    "prettier": "3.8.3",
    "ts-morph": "^28.0.0",
    "tsx": "4.22.0",
    "typescript": "^6.0.0-dev.20260416",
    "typescript-eslint": "8.72.0",
    "vite": "^8.1.6",
    "vitest": "^4.1.12"
  },
  "workspaces": [
    "packages/*"
  ]
}
