  "profile_contract": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "AgentProfileV1_2",
    "version": "1.2.0",
    "type": "object",
    "required": [
      "profile_id",
      "version",
      "contract_version",
      "role",
      "workflow_type",
      "system_prompt",
      "model_constraints",
      "budget_limits",
      "retention_class"
    ],
    "properties": {
      "profile_id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "version": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+\\.\\d+$"
      },
      "contract_version": {
        "type": "string",
        "enum": [
          "1.0.0",
          "1.1.0",
          "1.2.0"
        ],
        "default": "1.2.0"
      },
      "role": {
        "type": "string",
        "description": "Functional agent role (e.g., 'financial-analyst', 'canvas-researcher')"
      },
      "workflow_type": {
        "type": "string",
        "enum": [
          "structured_completion",
          "interactive_agent",
          "application_workflow"
        ],
        "description": "Declares the caller-owned workflow shape without selecting a different runtime lifecycle."
      },
      "description": {
        "type": "string"
      },
      "system_prompt": {
        "type": "string",
        "description": "Canonical Layer 0 system instructions and persona."
      },
      "allowed_global_capabilities": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^global\\.[a-z0-9_.]+(\\@\\d+(\\.\\d+)?)?$"
        },
        "description": "Explicit whitelist of registered global capabilities with optional semver constraint."
      },
      "allowed_local_tools": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+\\.[a-z0-9_.]+(\\@\\d+(\\.\\d+)?)?$"
        },
        "description": "Explicit whitelist of application-owned local tools."
      },
      "tool_policy": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "STRICT_WHITELIST",
              "DENYLIST"
            ]
          },
          "whitelist": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "denylist": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "require_signed_capability": {
            "type": "boolean"
          }
        },
        "description": "Transitional / legacy tool policy definition."
      },
      "model_constraints": {
        "type": "object",
        "required": [
          "default_model",
          "allowed_models",
          "allowed_providers"
        ],
        "properties": {
          "default_model": {
            "type": "string"
          },
          "allowed_models": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowed_providers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "temperature_range": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "budget_limits": {
        "type": "object",
        "required": [
          "max_tokens",
          "max_tool_calls",
          "max_duration_ms"
        ],
        "properties": {
          "max_tokens": {
            "type": "integer",
            "maximum": 32768
          },
          "max_tool_calls": {
            "type": "integer",
            "maximum": 50
          },
          "max_retries": {
            "type": "integer",
            "maximum": 5
          },
          "max_duration_ms": {
            "type": "integer",
            "maximum": 300000
          },
          "max_concurrent_workers": {
            "type": "integer",
            "maximum": 10
          }
        }
      },
      "plugins": {
        "type": "object",
        "properties": {
          "context_contributors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verifiers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "worker_plugins": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "retention_class": {
        "type": "string",
        "enum": [
          "EPHEMERAL",
          "AUDITED_SESSION",
          "PERMANENT_RECORD"
        ]
      },
      "observability_policy": {
        "type": "object",
        "properties": {
          "telemetry_level": {
            "type": "string",
            "enum": [
              "OFF",
              "METRICS_ONLY",
              "FULL_SPANS"
            ]
          },
          "redact_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sample_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  },
  "tool_contract": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ToolContractV1_2",
    "version": "1.2.0",
    "description": "Canonical Tool Contract v1.2 defining execution location, effect safety, and admission scopes.",
    "definitions": {
      "ToolDefinition": {
        "type": "object",
        "required": [
          "id",
          "version",
          "owner",
          "execution",
          "effect"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(global|[a-z0-9_-]+)\\.[a-z0-9_.]+$"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "owner": {
            "type": "string",
            "description": "Service or repository owning this tool definition."
          },
          "execution": {
            "type": "string",
            "enum": [
              "shared",
              "local"
            ],
            "description": "'shared' executes inside lazy-agent-service runtime; 'local' executes in caller application domain."
          },
          "effect": {
            "type": "string",
            "enum": [
              "read",
              "write",
              "destructive"
            ]
          },
          "resource_type": {
            "type": "string"
          },
          "required_scope": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Required scopes (e.g. ['app_id', 'session_id']) that must accompany local tool invocations."
          },
          "requires_confirmation": {
            "type": "boolean",
            "default": false
          },
          "requires_user_scope": {
            "type": "boolean",
            "default": false
          },
          "supports_evidence": {
            "type": "boolean",
            "default": false
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 100
          },
          "retryable": {
            "type": "boolean",
            "default": false
          },
          "legacy_aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "input_schema": {
            "type": "object"
          },
          "result_schema": {
            "type": "object"
          }
        }
      }
    }
  },
  "error_codes": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ErrorCodesCatalogV1_2",
    "version": "1.2.0",
    "description": "Authoritative machine-readable error codes for the shared agent runtime.",
    "errors": [
      {
        "code": "CONTRACT_VERSION_MISMATCH",
        "category": "CLIENT",
        "retryable": false,
        "description": "Requested contract major version is incompatible with the runtime."
      },
      {
        "code": "UNKNOWN_CAPABILITY",
        "category": "POLICY",
        "retryable": false,
        "description": "Requested capability ID is not registered in the CapabilityRegistry."
      },
      {
        "code": "UNSUPPORTED_CAPABILITY_VERSION",
        "category": "POLICY",
        "retryable": false,
        "description": "Capability version specified in profile is incompatible with registered capability version."
      },
      {
        "code": "PROFILE_NOT_FOUND",
        "category": "CLIENT",
        "retryable": false,
        "description": "Requested agent profile could not be found in the registry or loaded from disk."
      },
      {
        "code": "PROFILE_VALIDATION_ERROR",
        "category": "POLICY",
        "retryable": false,
        "description": "Profile manifest violated schema, model constraints, or capability permissions."
      },
      {
        "code": "POLICY_VIOLATION",
        "category": "POLICY",
        "retryable": false,
        "description": "Tool invocation violated execution policy, security boundary, or confirmation requirement."
      },
      {
        "code": "SCOPE_VIOLATION",
        "category": "POLICY",
        "retryable": false,
        "description": "Tool invocation lacked required application or session scope (app_id, session_id)."
      },
      {
        "code": "IDEMPOTENCY_CONFLICT",
        "category": "CLIENT",
        "retryable": true,
        "description": "Concurrent execution in progress under the same idempotency key."
      },
      {
        "code": "DEADLINE_EXCEEDED",
        "category": "RESOURCE",
        "retryable": false,
        "description": "Run execution exceeded the allocated wall-clock deadline."
      },
      {
        "code": "RUN_CANCELLED",
        "category": "CLIENT",
        "retryable": false,
        "description": "Run was explicitly cancelled via abort signal or cancellation endpoint."
      },
      {
        "code": "TOOL_EXECUTION_FAILED",
        "category": "TOOL",
        "retryable": false,
        "description": "Runtime execution of an authorized global capability failed."
      },
      {
        "code": "LOCAL_TOOL_ADMISSION_ERROR",
        "category": "TOOL",
        "retryable": false,
        "description": "Local application tool could not be admitted due to authorization or scoping error."
      },
      {
        "code": "RUNTIME_UNAVAILABLE",
        "category": "RUNTIME",
        "retryable": true,
        "description": "Shared agent runtime is unavailable or unreachable."
      },
      {
        "code": "MALFORMED_REQUEST",
        "category": "CLIENT",
        "retryable": false,
        "description": "Payload failed validation against canonical CreateRunRequest schema."
      }
    ]
  }
}